PRAGMA foreign_keys = ON;

CREATE TABLE IF NOT EXISTS INDUSTRY (
	industry_id INTEGER PRIMARY KEY AUTOINCREMENT,
	industry_name TEXT NOT NULL UNIQUE
);

CREATE TABLE IF NOT EXISTS EVENT_TYPE (
	event_type_id INTEGER PRIMARY KEY AUTOINCREMENT,
	event_type_name TEXT NOT NULL UNIQUE
);

CREATE TABLE IF NOT EXISTS CATERING_TYPE (
	catering_type_id INTEGER PRIMARY KEY AUTOINCREMENT,
	catering_type_name TEXT NOT NULL UNIQUE
);

CREATE TABLE IF NOT EXISTS STAFF_ROLE (
	role_id INTEGER PRIMARY KEY AUTOINCREMENT,
	role_name TEXT NOT NULL UNIQUE
);

CREATE TABLE IF NOT EXISTS SKILL (
	skill_id INTEGER PRIMARY KEY AUTOINCREMENT,
	skill_name TEXT NOT NULL UNIQUE
);

CREATE TABLE IF NOT EXISTS CLIENT (
	client_id INTEGER PRIMARY KEY AUTOINCREMENT,
	industry_id INTEGER NOT NULL,
	client_name TEXT NOT NULL,
	FOREIGN KEY (industry_id) REFERENCES INDUSTRY(industry_id)
);

CREATE TABLE IF NOT EXISTS CLIENT_CONTACT (
	contact_id INTEGER PRIMARY KEY AUTOINCREMENT,
	client_id INTEGER NOT NULL,
	contact_name TEXT NOT NULL,
	email TEXT,
	phone TEXT,
	is_primary_contact INTEGER NOT NULL DEFAULT 0 CHECK (is_primary_contact IN (0, 1)),
	FOREIGN KEY (client_id) REFERENCES CLIENT(client_id)
);

CREATE TABLE IF NOT EXISTS VENUE (
	venue_id INTEGER PRIMARY KEY AUTOINCREMENT,
	venue_name TEXT NOT NULL,
	venue_capacity INTEGER,
	venue_location TEXT,
	venue_hourly_rate REAL
);

CREATE TABLE IF NOT EXISTS STAFF (
	staff_id INTEGER PRIMARY KEY AUTOINCREMENT,
	role_id INTEGER NOT NULL,
	first_name TEXT NOT NULL,
	last_name TEXT NOT NULL,
	phone TEXT,
	FOREIGN KEY (role_id) REFERENCES STAFF_ROLE(role_id)
);

CREATE TABLE IF NOT EXISTS EVENT (
	event_id INTEGER PRIMARY KEY AUTOINCREMENT,
	client_id INTEGER NOT NULL,
	venue_id INTEGER NOT NULL,
	coordinator_staff_id INTEGER,
	event_type_id INTEGER NOT NULL,
	catering_type_id INTEGER,
	event_name TEXT NOT NULL,
	event_date TEXT,
	event_time TEXT,
	attendee_count INTEGER,
	duration_hours REAL,
	booking_date TEXT,
	event_status TEXT,
	special_requirements TEXT,
	actual_cost REAL,
	total_revenue REAL,
	FOREIGN KEY (client_id) REFERENCES CLIENT(client_id),
	FOREIGN KEY (venue_id) REFERENCES VENUE(venue_id),
	FOREIGN KEY (coordinator_staff_id) REFERENCES STAFF(staff_id),
	FOREIGN KEY (event_type_id) REFERENCES EVENT_TYPE(event_type_id),
	FOREIGN KEY (catering_type_id) REFERENCES CATERING_TYPE(catering_type_id)
);

CREATE TABLE IF NOT EXISTS EQUIPMENT (
	equipment_id INTEGER PRIMARY KEY AUTOINCREMENT,
	equipment_name TEXT NOT NULL UNIQUE
);

CREATE TABLE IF NOT EXISTS EVENT_EQUIPMENT (
	event_id INTEGER NOT NULL,
	equipment_id INTEGER NOT NULL,
	PRIMARY KEY (event_id, equipment_id),
	FOREIGN KEY (event_id) REFERENCES EVENT(event_id),
	FOREIGN KEY (equipment_id) REFERENCES EQUIPMENT(equipment_id)
);

CREATE TABLE IF NOT EXISTS EVENT_STAFF (
	event_staff_id INTEGER PRIMARY KEY AUTOINCREMENT,
	event_id INTEGER NOT NULL,
	staff_id INTEGER NOT NULL,
	assignment_role TEXT,
	hours_worked REAL,
	overtime_hours REAL,
	FOREIGN KEY (event_id) REFERENCES EVENT(event_id),
	FOREIGN KEY (staff_id) REFERENCES STAFF(staff_id)
);

CREATE TABLE IF NOT EXISTS INVOICE (
	invoice_id INTEGER PRIMARY KEY AUTOINCREMENT,
	event_id INTEGER NOT NULL UNIQUE,
	invoice_date TEXT,
	invoice_amount REAL,
	vat_amount REAL,
	payment_status TEXT,
	FOREIGN KEY (event_id) REFERENCES EVENT(event_id)
);

CREATE TABLE IF NOT EXISTS CLIENT_SATISFACTION (
	satisfaction_id INTEGER PRIMARY KEY AUTOINCREMENT,
	event_id INTEGER NOT NULL UNIQUE,
	satisfaction_score INTEGER CHECK (satisfaction_score BETWEEN 1 AND 10),
	feedback_comments TEXT,
	FOREIGN KEY (event_id) REFERENCES EVENT(event_id)
);
